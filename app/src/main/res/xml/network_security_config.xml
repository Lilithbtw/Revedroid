<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted Cloudreve instances often live on a LAN over plain HTTP or
     behind a private CA, so both are allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
